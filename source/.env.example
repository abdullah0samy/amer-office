# Copy separately to .env on each environment. Never commit values.
# Generate passwords/secrets locally; REPLACE is never a valid production value.
NODE_ENV=production
APP_ORIGIN=https://office.amerrashad.com
API_ORIGIN=https://office-api.amerrashad.com
# Public build-time config; frontend rebuild needed when this changes.
VITE_API_URL=https://office-api.amerrashad.com
POSTGRES_DB=amer_office
POSTGRES_USER=amer_office
POSTGRES_PASSWORD=REPLACE
# URI-encode password characters in this URL; hostname is PRIVATE service name.
DATABASE_URL=postgresql://amer_office:REPLACE@postgres:5432/amer_office
DB_POOL_SIZE=10
OFFICE_OWNER_EMAIL=REPLACE
AUTH_SECRET=REPLACE
SESSION_TTL_SECONDS=28800
# 64 lowercase hex characters; securely preserve old key for actual encrypted data.
TAX_CREDENTIALS_KEY=REPLACE
R2_ENDPOINT=https://REPLACE.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=REPLACE
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_FORCE_PATH_STYLE=false
SMTP_HOST=REPLACE
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
SMTP_FROM=REPLACE
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Optional private read-only mount; no real-client seed data in repository.
INSPECTION_SEEDS_PATH=
# One-off original import routes disabled unless these are set for an approved job:
IMPORT_JOB_TOKEN=
IMPORT_JOB_DIGEST=
IMPORT_JOB_EXPIRES=
# Optional one-off object migration credentials; not needed in regular runtime:
SOURCE_R2_ENDPOINT=
SOURCE_R2_REGION=auto
SOURCE_R2_BUCKET=
SOURCE_R2_ACCESS_KEY_ID=
SOURCE_R2_SECRET_ACCESS_KEY=
