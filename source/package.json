{
  "name": "amer-office-coolify",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:frontend": "vinext dev --hostname 0.0.0.0",
    "dev:backend": "tsx watch backend/server.ts",
    "build:frontend": "vinext build",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:frontend && npm run build:backend",
    "start:frontend": "node frontend/start.mjs",
    "start:backend": "node dist-backend/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:migrate": "node dist-backend/migrate.js",
    "admin:provision": "node dist-backend/admin.js",
    "data:import": "node dist-backend/import-data.js",
    "data:verify": "node dist-backend/verify-data.js",
    "r2:transfer": "node dist-backend/transfer-objects.js",
    "test:runtime": "node --test tests/runtime.smoke.mjs",
    "test:docker": "sh scripts/validate-docker.sh",
    "security:scan": "node scripts/security-scan.mjs",
    "test:http": "node --test tests/http-stack.smoke.mjs",
    "templates:import": "node dist-backend/import-office-templates.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.7.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "radix-ui": "1.6.7",
    "react": "19.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.85.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "vinext": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-socket": "0.0.19",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/smtp-server": "3.5.12",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "smtp-server": "3.16.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  }
